{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TrackingDb": "Host=localhost;Port=5437;Database=tracking_db;Username=tracking_user;Password=letmein;GSS Encryption Mode=Disable",
    "Redis": "localhost:6380,abortConnect=false"
  },
  "Jwt": {
    "MetadataAddress": "http://localhost/.well-known/openid-configuration",
    "Issuer": "https://auth.lastmile.internal",
    "Audiences": [ "last-mile-api", "tracking-service" ]
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "SchemaRegistryUrl": "http://localhost:8081",
    "AutoRegisterSchemas": true
  },
  "Tracking": {
    "LiveTtl": "00:10:00",
    "MaxFutureSkew": "00:00:30",
    "MaxPingAge": "00:10:00",
    "SampleInterval": "00:02:00",
    "SweepInterval": "00:00:30",
    "MaintenanceInterval": "01:00:00",
    "HistoryRetentionDays": 30,
    "PartitionsAhead": 3,
    "MaxBatchSize": 500,
    "ContextCacheSeconds": 5,
    "FleetStreamInterval": "00:00:01",
    "HeartbeatInterval": "00:00:15"
  }
