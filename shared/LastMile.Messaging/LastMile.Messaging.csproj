<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kafka plumbing shared by every Last-Mile service: transactional outbox (producers),
       inbox-based idempotent consumers, Schema Registry framing. See documents/kafka-architecture.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LastMile.Messaging</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.6.1" />
    <PackageReference Include="Confluent.SchemaRegistry" Version="2.6.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LastMile.Contracts/LastMile.Contracts.csproj" />
  </ItemGroup>

</Project>
